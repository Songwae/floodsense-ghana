---
// Conceptual illustration: a solar sensor node measuring a rising river and
// transmitting over GSM. Original vector art, drawn in the brand palette.
---
<svg class="node-scene" viewBox="0 0 460 360" role="img"
     aria-label="A solar-powered sensor node measures a river's water level and transmits an alert over the GSM network.">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f6ddb0"/>
      <stop offset="1" stop-color="#f4eee1"/>
    </linearGradient>
    <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#4f97a8"/>
      <stop offset="1" stop-color="#164e5d"/>
    </linearGradient>
  </defs>

  <!-- sky / harmattan haze -->
  <rect x="0" y="0" width="460" height="360" rx="14" fill="url(#sky)"/>
  <circle cx="360" cy="78" r="34" fill="#e9b654" opacity="0.55"/>

  <!-- distant savanna hills -->
  <path d="M0 214 Q90 182 180 206 T360 200 T460 210 V300 H0 Z" fill="#e2c79a" opacity="0.7"/>

  <!-- river -->
  <path d="M0 250 Q120 236 230 252 T460 250 V360 H0 Z" fill="url(#water)"/>
  <path d="M20 268 q60 -10 120 0 t120 0 t160 0" fill="none" stroke="#7fb6c4" stroke-width="2" opacity="0.6"/>
  <path d="M0 292 q80 -8 160 0 t160 0 t140 0" fill="none" stroke="#7fb6c4" stroke-width="2" opacity="0.45"/>

  <!-- node pole in the water -->
  <rect x="150" y="150" width="10" height="150" rx="3" fill="#3a2b20"/>
  <!-- measuring staff markings -->
  <g fill="#f4eee1">
    <rect x="150" y="200" width="10" height="4"/>
    <rect x="150" y="222" width="10" height="4"/>
    <rect x="150" y="244" width="10" height="4"/>
    <rect x="150" y="266" width="10" height="4"/>
  </g>

  <!-- solar panel -->
  <g transform="rotate(-18 155 128)">
    <rect x="120" y="112" width="72" height="42" rx="3" fill="#164e5d"/>
    <g stroke="#4f97a8" stroke-width="1.4">
      <line x1="120" y1="126" x2="192" y2="126"/>
      <line x1="120" y1="140" x2="192" y2="140"/>
      <line x1="144" y1="112" x2="144" y2="154"/>
      <line x1="168" y1="112" x2="168" y2="154"/>
    </g>
  </g>

  <!-- enclosure -->
  <rect x="140" y="156" width="30" height="26" rx="4" fill="#c25334"/>
  <circle cx="155" cy="169" r="4" fill="#f4eee1"/>

  <!-- GSM signal arcs -->
  <g fill="none" stroke="#c25334" stroke-width="3" stroke-linecap="round">
    <path d="M182 150 q22 -18 44 0" opacity="0.9"/>
    <path d="M176 162 q32 -28 64 0" opacity="0.6"/>
    <path d="M170 174 q42 -38 84 0" opacity="0.35"/>
  </g>

  <!-- phone receiving SMS -->
  <g transform="translate(330 150)">
    <rect x="0" y="0" width="66" height="118" rx="11" fill="#17130f"/>
    <rect x="5" y="6" width="56" height="106" rx="6" fill="#f4eee1"/>
    <rect x="24" y="10" width="18" height="4" rx="2" fill="#17130f"/>
    <!-- alert bubble -->
    <rect x="11" y="26" width="44" height="30" rx="6" fill="#fbeecd" stroke="#c07a12" stroke-width="1.5"/>
    <path d="M22 40 l4 6 8 -12" fill="none" stroke="#c07a12" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="11" y="64" width="44" height="5" rx="2.5" fill="#d6c6a8"/>
    <rect x="11" y="74" width="34" height="5" rx="2.5" fill="#d6c6a8"/>
    <rect x="11" y="84" width="40" height="5" rx="2.5" fill="#d6c6a8"/>
  </g>
</svg>

<style>
  .node-scene {
    width: 100%; height: auto;
    border-radius: 14px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--line-strong);
  }
</style>

---
// Horizontal data-flow diagram: Field → Network → Intelligence → Alert → Authorities
const stages = [
  { label: 'Sensor nodes', sub: 'Water level · rainfall · air quality', icon: 'node' },
  { label: 'GSM network', sub: 'Cellular uplink', icon: 'signal' },
  { label: 'LSTM model', sub: 'Flood-risk prediction', icon: 'ai' },
  { label: 'SMS alerts', sub: 'To basic phones', icon: 'sms' },
  { label: 'Map & dashboard', sub: 'For authorities', icon: 'dash' },
];
---
<ol class="flow" aria-label="Data flow from field sensors to community alerts and authority dashboards">
  {stages.map((s, i) => (
    <li class="flow__step">
      <div class="flow__icon" data-icon={s.icon} aria-hidden="true">
        {s.icon === 'node' && <svg viewBox="0 0 24 24"><path d="M12 2v20M6 8h12M4 14h16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>}
        {s.icon === 'signal' && <svg viewBox="0 0 24 24"><path d="M5 12a7 7 0 0114 0M8 12a4 4 0 018 0" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="12" cy="12" r="2" fill="currentColor"/></svg>}
        {s.icon === 'ai' && <svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="3" stroke="currentColor" stroke-width="2" fill="none"/><path d="M9 9h6v6H9z" fill="currentColor"/></svg>}
        {s.icon === 'sms' && <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="13" rx="3" stroke="currentColor" stroke-width="2" fill="none"/><path d="M7 10h10M7 13h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
        {s.icon === 'dash' && <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" fill="none"/><path d="M7 15l3-4 3 3 4-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>}
      </div>
      <span class="flow__label">{s.label}</span>
      <span class="flow__sub">{s.sub}</span>
      {i < stages.length - 1 && <span class="flow__arrow" aria-hidden="true">→</span>}
    </li>
  ))}
</ol>

<style>
  .flow {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.5rem;
  }
  .flow__step {
    position: relative; text-align: center;
    padding: 1.2rem 0.7rem; background: var(--bg-panel);
    border: 1px solid var(--line); border-radius: var(--radius-lg);
    display: flex; flex-direction: column; align-items: center; gap: 0.3rem;
  }
  .flow__icon {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--sand-100); color: var(--clay-600);
    display: grid; place-items: center; margin-bottom: 0.4rem;
  }
  .flow__icon svg { width: 24px; height: 24px; }
  .flow__label { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; }
  .flow__sub { font-size: 0.78rem; color: var(--text-muted); line-height: 1.3; }
  .flow__arrow {
    position: absolute; right: -0.55rem; top: 50%; transform: translateY(-50%);
    color: var(--gold-500); font-weight: 700; z-index: 2;
  }
  @media (max-width: 760px) {
    .flow { grid-template-columns: 1fr; }
    .flow__step { flex-direction: row; text-align: left; align-items: center; gap: 0.9rem; }
    .flow__icon { margin-bottom: 0; flex: none; }
    .flow__sub { margin-left: auto; }
    .flow__arrow { right: 50%; top: auto; bottom: -0.7rem; transform: translateX(50%) rotate(90deg); }
  }
</style>

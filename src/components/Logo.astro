---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<span class="logo">
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path d="M2 21c3 0 3 2 6 2s3-2 6-2 3 2 6 2 3-2 6-2 3 2 4 2v9H2z" fill="var(--volta-500)"/>
    <path d="M2 24c3 0 3 2 6 2s3-2 6-2 3 2 6 2 3-2 6-2 3 2 4 2" fill="none" stroke="var(--volta-300)" stroke-width="1.4"/>
    <rect x="14.4" y="4" width="3.2" height="17" rx="1.2" fill="var(--gold-500)"/>
    <rect x="14.4" y="8" width="3.2" height="1.6" fill="var(--ink-900)"/>
    <rect x="14.4" y="12.5" width="3.2" height="1.6" fill="var(--ink-900)"/>
    <rect x="14.4" y="17" width="3.2" height="1.6" fill="var(--ink-900)"/>
    <circle cx="16" cy="4" r="2.6" fill="var(--clay-500)"/>
  </svg>
  {!compact && (
    <span class="logo__word">
      Flood<strong>Sense</strong>
      <span class="logo__gh">Ghana</span>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; }
  .logo__mark { width: 30px; height: 30px; flex: none; }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink-900);
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
  }
  .logo__word strong { font-weight: 700; }
  .logo__gh {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--clay-600);
    border: 1px solid var(--line-strong);
    padding: 0.12rem 0.35rem;
    border-radius: 3px;
    transform: translateY(-1px);
  }
</style>

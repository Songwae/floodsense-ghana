---
import type { Status } from '../data/site';
import { statusLabel } from '../data/site';

interface Props {
  status: Status;
  class?: string;
}
const { status, class: className = '' } = Astro.props;
---
<span class={`status status--${status} ${className}`} title={statusLabel[status]}>
  {statusLabel[status]}
</span>

---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
const year = 2026;
---
<div class="weave-rule" role="presentation"></div>
<footer class="site-footer section--deep">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" aria-label="FloodSense Ghana — home" class="site-footer__logo"><Logo /></a>
      <p class="site-footer__blurb">{site.description}</p>
      <p class="site-footer__region">📍 Target deployment: {site.region} · {site.origin}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <h2 class="site-footer__heading">Explore</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__contact">
      <h2 class="site-footer__heading">Contact</h2>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="muted-on-deep">For partnership, funding, and press enquiries.</p>
      <a href="/contact/" class="btn btn-ghost">Get in touch</a>
    </div>
  </div>

  <div class="container site-footer__base">
    <p>© {year} {site.name}. Developed from the Upper East Region — for Accra's flood-exposed communities.</p>
    <p class="muted-on-deep">An early-stage engineering venture — status labels reflect real build progress.</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(2.8rem, 6vw, 4.5rem) 1.8rem; }
  .site-footer :global(.logo__word) { color: #fff; }
  .site-footer :global(.logo__gh) { color: var(--gold-300); border-color: rgba(255,255,255,0.25); }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.3fr;
    gap: clamp(1.6rem, 4vw, 3rem);
  }
  .site-footer__blurb { color: var(--text-on-deep-muted); margin-top: 1rem; max-width: 40ch; font-size: 0.95rem; }
  .site-footer__region { color: var(--gold-300); margin-top: 0.8rem; font-size: 0.9rem; }
  .site-footer__heading {
    font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--gold-300); margin-bottom: 0.9rem;
  }
  .site-footer__nav ul { list-style: none; padding: 0; display: grid; gap: 0.55rem; }
  .site-footer a { color: var(--text-on-deep); text-decoration: none; }
  .site-footer a:hover { color: var(--gold-300); text-decoration: underline; }
  .muted-on-deep { color: var(--text-on-deep-muted); font-size: 0.9rem; }
  .site-footer__contact .btn { margin-top: 1rem; }
  .site-footer__contact p { margin-bottom: 0.4rem; }
  .site-footer__base {
    display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; justify-content: space-between;
    margin-top: clamp(2rem, 5vw, 3rem); padding-top: 1.4rem;
    border-top: 1px solid rgba(255,255,255,0.12);
    font-size: 0.85rem; color: var(--text-on-deep-muted);
  }
  @media (max-width: 720px) {
    .site-footer__inner { grid-template-columns: 1fr; }
  }
</style>

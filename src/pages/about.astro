---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import founderPhoto from '../assets/founder.jpg';
import fieldTransformer from '../assets/field-transformer.jpg';
import fieldSolar from '../assets/field-solar.jpg';
import fieldPanel from '../assets/field-panel.jpg';
import fieldInverter from '../assets/field-inverter.jpg';

const fieldPhotos = [
  { src: fieldTransformer, alt: 'The founder in a hard hat and high-visibility vest in front of a distribution transformer' },
  { src: fieldSolar, alt: 'The founder at a utility-scale solar farm, panels stretching into the distance' },
  { src: fieldPanel, alt: 'The founder wiring a control panel with contactors and terminal blocks' },
  { src: fieldInverter, alt: 'The founder working on the internals of a power inverter in a workshop' },
];
---
<BaseLayout
  title="About"
  description="FloodSense Ghana is an early-warning venture targeting Accra’s flood-prone communities, founded by an Electrical & Electronics Engineering student at Bolgatanga Technical University.">

  <PageHeader
    eyebrow="About the venture"
    title="Engineering early warning where it's needed most."
    lede="FloodSense Ghana began with a simple observation: the communities most exposed to flooding are often the last to be warned. Nowhere is that truer than Accra, the most heavily flooded area in Ghana and the system's target for deployment."
  />

  <!-- MISSION -->
  <section class="section">
    <div class="container about__grid">
      <div class="prose stack">
        <h2>Why FloodSense exists</h2>
        <p>
          Accra floods, and it floods hard. In dense, fast-growing
          neighbourhoods like Adenta and Madina, the rains repeatedly overwhelm
          drains and waterways, and warnings arrive too late or not at all.
          FloodSense has already been presented to communities and NADMO
          officials in both areas. For households with no smartphone and no
          data bundle, app-based alerts simply never arrive.
        </p>
        <p>
          FloodSense starts from that reality: sense conditions at the water's
          edge, predict rising risk with a model trained on local data, and
          deliver the warning by <strong>SMS</strong>, a channel that reaches
          the phones people already own.
        </p>
        <p>
          This is an early-stage venture and the site says so plainly. Parts of
          the system are in active development; others are still on the drawing
          board. Each one is labelled, because credibility with communities and
          agencies matters more than polish.
        </p>
      </div>
      <aside class="values card">
        <h3>What guides the work</h3>
        <ul>
          <li><strong>Reach the unreached.</strong> Design for basic phones and off-grid sites first.</li>
          <li><strong>Local data, local relevance.</strong> Model on the region's own patterns.</li>
          <li><strong>Say what's real.</strong> Never imply more is deployed than actually is.</li>
          <li><strong>Build with institutions.</strong> Government, research, and community together.</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="section section--panel" id="founder">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The founder</p>
        <h2>Who's behind it</h2>
      </div>
      <div class="founder">
        <div class="founder__photo">
          <Image
            src={founderPhoto}
            alt={`${site.founderName}, founder of FloodSense Ghana`}
            widths={[210, 420]}
            sizes="(max-width: 820px) 150px, 210px"
          />
        </div>
        <div class="stack">
          <h3 class="founder__name">{site.founderName}</h3>
          <p class="founder__role">
            Founder · Electrical &amp; Electronics Engineering student,
            {site.institution}
          </p>
          <p>
            FloodSense Ghana is led by an Electrical &amp; Electronics
            Engineering student at {site.institution} in the Upper East Region.
            The venture is developed from the Upper East and targeted at Accra,
            where it has already been presented to NADMO officials and community
            stakeholders. The work spans the full stack: sensor-node hardware
            and firmware, the LSTM prediction model, and the SMS alerting
            pipeline.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- IN THE FIELD -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">In the field</p>
        <h2>Hands-on power engineering</h2>
        <p class="lede">
          The engineering behind FloodSense comes from real fieldwork:
          distribution transformers, utility-scale solar, control panels, and
          power electronics.
        </p>
      </div>
      <div class="fieldgrid">
        {fieldPhotos.map((p) => (
          <figure class="fieldgrid__item">
            <Image src={p.src} alt={p.alt} widths={[420, 840]} sizes="(max-width: 820px) 45vw, 280px" />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- PLACE -->
  <section class="section section--panel">
    <div class="container about__place">
      <div>
        <p class="eyebrow">Grounded in place</p>
        <h2>Made in the Upper East. Aimed at Accra.</h2>
      </div>
      <div class="prose stack">
        <p>
          FloodSense is engineered from Bolgatanga in the Upper East Region and
          targeted at Accra, where flooding hits hardest and most often. That
          pairing is deliberate. The discipline of building low-cost, off-grid,
          SMS-first technology for northern conditions is exactly what Accra's
          most exposed, least-connected communities need, and the system is
          built to extend to other flood-prone areas across Ghana.
        </p>
        <p><a href="/partnerships/" class="btn btn-ghost">See our partners &amp; recognition</a></p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--deep">
    <div class="container center-x stack">
      <h2>Work with us</h2>
      <p class="lede" style="color:var(--text-on-deep-muted); margin-inline:auto">
        Funders, agencies, researchers, and press: we'd like to hear from you.
      </p>
      <p><a href="/contact/" class="btn btn-primary">Get in touch</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .about__grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(1.6rem, 4vw, 3rem); align-items: start; }
  .about__grid h2 { font-size: var(--step-3); margin-bottom: 0.6rem; }

  .values { background: var(--ink-900); color: var(--sand-100); border-color: transparent; position: sticky; top: 90px; }
  .values h3 { color: #fff; font-size: var(--step-1); margin-bottom: 0.9rem; }
  .values ul { list-style: none; padding: 0; display: grid; gap: 0.9rem; }
  .values li { position: relative; padding-left: 1.3rem; font-size: 0.95rem; color: var(--text-on-deep-muted); }
  .values li strong { color: var(--gold-300); font-weight: 600; }
  .values li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 8px; height: 8px; border-radius: 50%; background: var(--clay-500); }

  .section-head { max-width: 60ch; margin-bottom: clamp(1.4rem, 3vw, 2.2rem); }
  .section-head h2 { font-size: var(--step-3); margin-top: 0.4rem; }

  .founder { display: grid; grid-template-columns: auto 1fr; gap: clamp(1.4rem, 4vw, 2.6rem); align-items: center; }
  .founder__photo {
    width: clamp(150px, 22vw, 210px); aspect-ratio: 1; border-radius: 18px;
    overflow: hidden; box-shadow: var(--shadow-md);
    border: 1px solid var(--line-strong);
  }
  .founder__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .founder__name { font-size: var(--step-2); }
  .founder__role { color: var(--brand); font-weight: 600; }
  .founder__edit { font-size: 0.9rem; border-left: 3px solid var(--line-strong); padding-left: 0.8rem; }

  .about__place { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(1.6rem, 4vw, 3rem); align-items: start; }
  .about__place h2 { font-size: var(--step-3); margin-top: 0.4rem; }

  .fieldgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; }
  .fieldgrid__item { margin: 0; }
  .fieldgrid__item img {
    width: 100%; height: 100%; object-fit: cover; aspect-ratio: 3 / 4;
    border-radius: 12px; border: 1px solid var(--line-strong); box-shadow: var(--shadow-sm);
  }
  @media (max-width: 820px) {
    .fieldgrid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 820px) {
    .about__grid, .about__place { grid-template-columns: 1fr; }
    .values { position: static; }
    .founder { grid-template-columns: 1fr; text-align: left; }
  }
</style>

---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { partners, recognition, pressLinks } from '../data/site';
import aetcMinistryPresentation from '../assets/aetc-ministry-presentation.jpg';
import aetcMinistryDiscussion from '../assets/aetc-ministry-discussion.jpg';
import aetcDiscussionDiptych from '../assets/aetc-discussion-diptych.jpg';
import aetcPecanVisit from '../assets/aetc-pecan-visit.jpg';
import aetcAkumah from '../assets/aetc-akumah.jpg';

const gallery = [
  {
    src: aetcMinistryPresentation,
    wide: true,
    alt: 'The AETC delegation with Hon. George Opare Addo, Minister for Youth Development and Empowerment, holding a framed presentation',
    cap: 'With Hon. George Opare Addo, Minister for Youth Development and Empowerment, during the official visit with the AETC delegation.',
  },
  {
    src: aetcPecanVisit,
    wide: false,
    alt: 'Group photo at Pecan Energies with AETC leadership and pitch challenge winners',
    cap: 'At Pecan Energies in Accra, where FloodSense was presented during an AETC industry visit.',
  },
  {
    src: aetcAkumah,
    wide: false,
    alt: 'The founder with Ms Emelia Akumah, Founder and President of the AETC, and a fellow pitch challenge winner',
    cap: 'With Ms Emelia Akumah, Founder and President of the AETC.',
  },
  {
    src: aetcMinistryDiscussion,
    wide: false,
    alt: 'A round-table discussion with the Minister and his team at the Ministry of Youth Development and Empowerment',
    cap: 'In discussion with the Minister and his team at the Ministry.',
  },
  {
    src: aetcDiscussionDiptych,
    wide: false,
    alt: 'The founder presenting FloodSense during the ministry meeting',
    cap: "Presenting FloodSense to the Minister's team.",
  },
];

// Richer context for each partner, keyed by name.
const detail: Record<string, string> = {
  'Africa Energy Technology Centre (AETC)':
    'A signed ambassador program with the AETC, founded and led by Ms Emelia Akumah, won through its NextGen Innovation Pitch Challenge. The program has opened doors to industry and government, including the official presentation of FloodSense to the Ministry of Youth Development and Empowerment and an industry visit to Pecan Energies.',
  'CSIR Water Research Institute':
    "Ghana's national water-science institute, and a research partner on hydrological data, water-level science, and validation of the prediction approach.",
  'Ghana Meteorological Agency (GMet)':
    'The national weather authority, and a research partner for the rainfall and climate data that feed the flood-prediction model.',
};
---
<BaseLayout
  title="Partnerships & Recognition"
  description="FloodSense Ghana's institutional backing: a signed AETC ambassador program, research ties with CSIR-WRI and GMet, official presentation to the Ministry of Youth Development and Empowerment, and engagement with NADMO and Accra communities.">

  <PageHeader
    eyebrow="Backing &amp; recognition"
    title="Built with institutions, and accountable to them."
    lede="FloodSense is developed alongside research institutions and Ghana's innovation ecosystem, and has been presented directly to the government agencies responsible for disaster response. These relationships keep the work grounded in the science, the policy, and the needs of Accra's at-risk communities."
  />

  <!-- PARTNERS -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Partners</p>
        <h2>Who we work with</h2>
      </div>
      <div class="partners">
        {partners.map((p) => (
          <article class="partner card">
            <div class="partner__top">
              <h3>{p.name}</h3>
              <span class="partner__rel">{p.relation}</span>
            </div>
            <p class="partner__note">{p.note}</p>
            <p>{detail[p.name]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- RECOGNITION -->
  <section class="section section--panel">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Recognition &amp; milestones</p>
        <h2>Where FloodSense has been recognised</h2>
      </div>
      <ol class="timeline">
        {recognition.map((r) => (
          <li class="timeline__item">
            <span class="timeline__dot" aria-hidden="true"></span>
            <span class="timeline__kind">{r.kind}</span>
            <p class="timeline__title">
              {r.title}{r.note && <em> · {r.note}</em>}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ON THE GROUND -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">On the ground</p>
        <h2>These engagements, in pictures</h2>
      </div>
      <div class="gallery">
        {gallery.map((g) => (
          <figure class:list={['gallery__item', { 'gallery__item--wide': g.wide }]}>
            <Image src={g.src} alt={g.alt} widths={[560, 1120]} sizes="(max-width: 820px) 92vw, 560px" />
            <figcaption>{g.cap}</figcaption>
          </figure>
        ))}
      </div>
      <p class="gallery__credit">All photos: Africa Energy Technology Centre (AETC).</p>
    </div>
  </section>

  <!-- IN THE NEWS -->
  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Coverage</p>
        <h2>Read about these engagements</h2>
      </div>
      <ul class="press">
        {pressLinks.map((l) => (
          <li class="press__item card">
            <a href={l.href} target="_blank" rel="noopener">{l.title}</a>
            <span class="press__src">{l.source}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- HONEST NOTE -->
  <section class="section section--tight">
    <div class="container">
      <p class="honest-note">
        <strong>A note on how we present this.</strong> Every partnership and
        award listed here is real and current. We keep this page factual: no
        logos we have not earned the right to use, and no claims of deployment
        we have not reached. That discipline is what makes the recognition
        worth something.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--deep">
    <div class="container center-x stack">
      <h2>Interested in partnering or funding the next stage?</h2>
      <p class="lede" style="color:var(--text-on-deep-muted); margin-inline:auto">
        We're looking for collaborators to help move FloodSense from development
        toward real deployment in flood-exposed communities.
      </p>
      <p><a href="/contact/" class="btn btn-primary">Start a conversation</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .section-head { max-width: 60ch; margin-bottom: clamp(1.6rem, 4vw, 2.6rem); }
  .section-head h2 { font-size: var(--step-3); margin-block: 0.5rem 0; }

  .partners { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.2rem; }
  .partner__top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
  .partner__top h3 { font-size: var(--step-1); }
  .partner__rel {
    font-family: var(--font-display); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: #fff;
    background: var(--clay-600); padding: 0.2rem 0.55rem; border-radius: 100px; white-space: nowrap;
  }
  .partner__note { color: var(--gold-600); font-weight: 600; font-size: 0.85rem; margin: 0.5rem 0 0.6rem; }
  .partner p:last-child { color: var(--text-muted); }

  .timeline { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; position: relative; }
  .timeline::before {
    content: ""; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 2px; background: var(--line-strong);
  }
  .timeline__item { position: relative; padding: 0 0 1.6rem 2.2rem; }
  .timeline__item:last-child { padding-bottom: 0; }
  .timeline__dot {
    position: absolute; left: 0; top: 3px; width: 16px; height: 16px; border-radius: 50%;
    background: var(--gold-500); border: 3px solid var(--bg); box-shadow: 0 0 0 1px var(--line-strong);
  }
  .timeline__kind {
    font-family: var(--font-display); font-size: 0.68rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--brand);
  }
  .timeline__title { font-size: var(--step-1); font-family: var(--font-display); font-weight: 500; margin-top: 0.2rem; }
  .timeline__title em { font-style: normal; color: var(--text-muted); font-size: 0.9rem; }

  .honest-note {
    max-width: var(--measure); margin-inline: auto; font-size: 1rem; color: var(--ink-700);
    border-left: 3px solid var(--accent); padding-left: 1.1rem;
  }

  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  .gallery__item { margin: 0; }
  .gallery__item--wide { grid-column: 1 / -1; }
  .gallery__item img {
    width: 100%; height: auto; border-radius: 12px;
    border: 1px solid var(--line-strong); box-shadow: var(--shadow-sm);
  }
  .gallery__item figcaption { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem; }
  .gallery__credit { font-size: 0.78rem; color: var(--text-muted); margin-top: 1.2rem; }
  @media (max-width: 700px) {
    .gallery { grid-template-columns: 1fr; }
  }

  .press { list-style: none; padding: 0; display: grid; gap: 0.8rem; }
  .press__item { display: grid; gap: 0.3rem; padding: 1rem 1.2rem; }
  .press__item a {
    font-family: var(--font-display); font-weight: 600; color: var(--ink-900);
    text-decoration: none; font-size: 1.05rem;
  }
  .press__item a:hover { color: var(--brand-strong); text-decoration: underline; }
  .press__src { font-size: 0.78rem; color: var(--text-muted); letter-spacing: 0.04em; }
</style>

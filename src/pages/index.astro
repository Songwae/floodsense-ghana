---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { system, partners, recognition, site } from '../data/site';
import floodAerial from '../assets/flood-aerial.jpg';
---
<BaseLayout>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy stack">
        <p class="eyebrow">Multi-hazard early warning · {site.region}</p>
        <h1 class="hero__title">
          Warning communities <span class="hl">before</span> the water rises.
        </h1>
        <p class="lede">
          FloodSense Ghana is an IoT early-warning system: solar-powered sensor
          nodes, an AI flood-prediction model, and SMS alerts that reach basic
          phones. It is being built for Accra, the most heavily flooded area in
          Ghana.
        </p>
        <div class="hero__actions">
          <a href="/technology/" class="btn btn-primary">See how it works</a>
          <a href="/partnerships/" class="btn btn-ghost">Partnerships &amp; recognition</a>
        </div>
        <p class="hero__honest">
          <strong>An early-stage venture.</strong> Every part of the system
          below carries its real build status, so you can see exactly what
          exists today.
        </p>
      </div>

      <figure class="hero__art">
        <div class="hero__photo">
          <video
            controls
            preload="metadata"
            playsinline
            aria-label="FloodSense Ghana introduction video"
          >
            <source src="/media/floodsense-home.mp4" type="video/mp4" />
            Your browser does not support embedded video.
            <a href="/media/floodsense-home.mp4">Download the video</a> instead.
          </video>
          <div class="hero__badge">
            <span class="hero__badge-k">Winner</span>
            <span class="hero__badge-v">AETC NextGen Innovation Pitch Challenge 2026</span>
          </div>
        </div>
        <figcaption class="hero__credit">
          FloodSense Ghana project introduction
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="weave-rule" role="presentation"></div>

  <!-- ===================== THE PROBLEM ===================== -->
  <section class="section section--panel">
    <div class="container problem__grid">
      <div>
        <p class="eyebrow">The problem</p>
        <h2 class="problem__title">
          Floods arrive fast. Warnings arrive late, or not at all.
        </h2>
      </div>
      <div class="prose stack">
        <p>
          Accra is the most heavily flooded area in Ghana. Almost every rainy
          season, rising water in dense, fast-growing neighbourhoods like Adenta
          and Madina damages homes, businesses, and livelihoods. Warnings
          routinely come late or never reach the people in harm's way.
        </p>
        <p>
          FloodSense closes that gap with low-cost sensing at the water's edge,
          a model that learns local patterns, and a warning channel that works
          on the phones people already carry: <strong>plain SMS</strong>.
        </p>
      </div>
    </div>
    <div class="container">
      <figure class="problem__figure">
        <Image
          src={floodAerial}
          alt="Aerial view of a dense neighbourhood inundated by brown floodwater, streets and homes submerged"
          widths={[720, 1080]}
          sizes="(max-width: 860px) 92vw, 1080px"
        />
        <figcaption>
          When drains and waterways overflow, whole neighbourhoods go under,
          often with no warning at all. <span class="muted">(Illustrative image.)</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ===================== SYSTEM OVERVIEW ===================== -->
  <section class="section" id="system">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The system</p>
        <h2>Five subsystems, from the water's edge to the phone.</h2>
        <p class="lede">
          Data flows from the field to the community. Each subsystem is labelled
          with its current status.
        </p>
      </div>

      <ol class="pipeline">
        {system.map((s, i) => (
          <li class="pipeline__item card">
            <div class="pipeline__num">{String(i + 1).padStart(2, '0')}</div>
            <div class="pipeline__body">
              <div class="pipeline__topline">
                <h3>{s.name}</h3>
                <StatusBadge status={s.status} />
              </div>
              <p>{s.summary}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="center-x" style="margin-top:1.8rem">
        <a href="/technology/" class="btn btn-ghost">Full technical breakdown</a>
      </p>
    </div>
  </section>

  <!-- ===================== HONESTY CALLOUT ===================== -->
  <section class="section section--deep honesty">
    <div class="container honesty__grid">
      <div class="stack">
        <p class="eyebrow">Where things really stand</p>
        <h2>What's built, and what isn't.</h2>
        <p class="lede" style="color:var(--text-on-deep-muted)">
          Credibility with partners like NADMO and our research collaborators
          depends on never overstating deployment. This is the whole system, by
          status.
        </p>
      </div>
      <div class="honesty__cols">
        <div class="honesty__col">
          <StatusBadge status="dev" />
          <ul>
            {system.filter((s) => s.status === 'dev').map((s) => <li>{s.name}</li>)}
          </ul>
        </div>
        <div class="honesty__col">
          <StatusBadge status="design" />
          <ul>
            {system.filter((s) => s.status === 'design').map((s) => <li>{s.name}</li>)}
          </ul>
        </div>
        <div class="honesty__col">
          <StatusBadge status="field" />
          <ul>
            <li>Presented to NADMO &amp; community stakeholders (Adenta, Madina)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PARTNERS + RECOGNITION ===================== -->
  <section class="section section--panel">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Backing &amp; recognition</p>
        <h2>The institutions behind the work.</h2>
      </div>

      <div class="partner-strip">
        {partners.map((p) => (
          <div class="partner-chip">
            <span class="partner-chip__name">{p.name}</span>
            <span class="partner-chip__rel">{p.relation}</span>
          </div>
        ))}
      </div>

      <ul class="recognition">
        {recognition.map((r) => (
          <li class="recognition__item">
            <span class="recognition__kind">{r.kind}</span>
            <span class="recognition__title">
              {r.title}{r.note && <em> · {r.note}</em>}
            </span>
          </li>
        ))}
      </ul>

      <p class="center-x" style="margin-top:1.8rem">
        <a href="/partnerships/" class="btn btn-ghost">More on our partnerships</a>
      </p>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="section cta">
    <div class="container cta__inner">
      <div class="stack">
        <h2>Partner with a system built for the people most exposed.</h2>
        <p class="lede">
          We're speaking with funders, agencies, and researchers who want early
          warning to reach the communities that current systems miss.
        </p>
      </div>
      <div class="cta__actions">
        <a href="/contact/" class="btn btn-primary">Get in touch</a>
        <a href="/about/" class="btn btn-ghost">Meet the founder</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem); position: relative; overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(120% 90% at 88% -10%, #f6ddb0 0%, transparent 55%),
      radial-gradient(90% 80% at 0% 110%, #eadfca 0%, transparent 50%);
  }
  .hero__grid {
    display: grid; grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem); align-items: center;
  }
  .hero__title { font-size: var(--step-5); margin-block: 0.4rem 0.2rem; }
  .hero__title .hl {
    color: var(--brand);
    background: linear-gradient(transparent 62%, var(--gold-300) 62%);
    padding-inline: 0.1em;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.6rem; }
  .hero__honest {
    font-size: 0.95rem; color: var(--ink-700);
    border-left: 3px solid var(--accent); padding-left: 0.9rem; margin-top: 0.4rem;
  }
  .hero__art { position: relative; margin: 0; }
  .hero__photo { position: relative; border-radius: 14px; overflow: hidden;
    box-shadow: var(--shadow-md); border: 1px solid var(--line-strong);
    background: var(--ink-900); }
  .hero__photo video { display: block; width: 100%; height: auto; max-height: 70vh; }
  .hero__credit {
    font-size: 0.72rem; color: var(--text-muted); margin-top: 0.5rem; text-align: right;
  }
  .hero__credit a { color: var(--text-muted); }
  .hero__badge {
    position: absolute; right: 12px; top: 12px;
    background: color-mix(in srgb, var(--ink-900) 92%, transparent); color: #fff;
    border-radius: 10px; padding: 0.7rem 1rem; box-shadow: var(--shadow-md);
    display: grid; gap: 0.15rem; max-width: 220px;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }
  .hero__badge-k { font-family: var(--font-display); font-weight: 700; color: var(--gold-300); }
  .hero__badge-v { font-size: 0.8rem; color: var(--text-on-deep-muted); line-height: 1.3; }

  /* ---- Section head ---- */
  .section-head { max-width: 60ch; margin-bottom: clamp(1.8rem, 4vw, 2.8rem); }
  .section-head h2 { font-size: var(--step-3); margin-block: 0.5rem 0.6rem; }

  /* ---- Problem ---- */
  .problem__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .problem__title { font-size: var(--step-3); margin-top: 0.5rem; }
  .problem__figure { margin: clamp(1.8rem, 4vw, 2.8rem) 0 0; }
  .problem__figure img {
    width: 100%; height: auto; max-height: 460px; object-fit: cover;
    border-radius: 14px; border: 1px solid var(--line-strong); box-shadow: var(--shadow-md);
  }
  .problem__figure figcaption { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.6rem; }

  /* ---- Pipeline ---- */
  .pipeline { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .pipeline__item { display: grid; grid-template-columns: auto 1fr; gap: 1.1rem; align-items: center; }
  .pipeline__num {
    font-family: var(--font-display); font-weight: 700; font-size: 1.5rem;
    color: var(--clay-300); background: var(--sand-100);
    width: 52px; height: 52px; border-radius: 10px;
    display: grid; place-items: center; flex: none;
  }
  .pipeline__topline { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 0.9rem; }
  .pipeline__topline h3 { font-size: var(--step-1); }
  .pipeline__body p { color: var(--text-muted); margin-top: 0.3rem; }

  /* ---- Honesty ---- */
  .honesty__grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(1.8rem, 4vw, 3.5rem); align-items: start; }
  .honesty__grid h2 { font-size: var(--step-3); }
  .honesty__cols { display: grid; gap: 1.2rem; }
  .honesty__col {
    border: 1px solid rgba(255,255,255,0.14); border-radius: var(--radius-lg);
    padding: 1.1rem 1.2rem; background: rgba(255,255,255,0.04);
  }
  .honesty__col ul { list-style: none; padding: 0; margin-top: 0.8rem; display: grid; gap: 0.4rem; }
  .honesty__col li { color: var(--text-on-deep); position: relative; padding-left: 1.1rem; }
  .honesty__col li::before { content: "·"; position: absolute; left: 0; color: var(--gold-300); font-weight: 700; }

  /* ---- Partners ---- */
  .partner-strip { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 2rem; }
  .partner-chip {
    background: var(--bg-panel); border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg); padding: 0.8rem 1.1rem; display: grid; gap: 0.15rem;
    box-shadow: var(--shadow-sm); flex: 1 1 220px;
  }
  .partner-chip__name { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.01em; }
  .partner-chip__rel { font-size: 0.82rem; color: var(--brand); font-weight: 600; }

  .recognition { list-style: none; padding: 0; display: grid; gap: 0.7rem; }
  .recognition__item {
    display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: baseline;
    padding: 0.9rem 1.1rem; background: var(--bg-panel);
    border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: var(--radius);
  }
  .recognition__kind {
    font-family: var(--font-display); font-size: 0.68rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-600);
    white-space: nowrap;
  }
  .recognition__title { font-weight: 500; }
  .recognition__title em { color: var(--text-muted); font-style: normal; }

  /* ---- CTA ---- */
  .cta__inner {
    display: grid; grid-template-columns: 1.4fr auto; gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: linear-gradient(120deg, var(--clay-700), var(--clay-600));
    color: #fff; border-radius: var(--radius-lg); padding: clamp(1.8rem, 4vw, 3rem);
  }
  .cta__inner h2 { color: #fff; font-size: var(--step-2); }
  .cta__inner .lede { color: #f7e6d9; }
  .cta__actions { display: grid; gap: 0.7rem; }
  .cta .btn-ghost { color: #fff; border-color: rgba(255,255,255,0.4); }
  .cta .btn-ghost:hover { border-color: var(--gold-300); color: var(--gold-300); }

  @media (max-width: 860px) {
    .hero__grid, .problem__grid, .honesty__grid, .cta__inner { grid-template-columns: 1fr; }
    .hero__art { order: -1; max-width: 460px; }
    .cta__actions { grid-auto-flow: column; justify-content: start; flex-wrap: wrap; }
  }
</style>

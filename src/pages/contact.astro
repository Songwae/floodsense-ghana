---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';

const routes = [
  { k: 'Partnerships', d: 'Government, research, and development collaborators.', s: 'Partnership enquiry: FloodSense Ghana' },
  { k: 'Funding', d: 'Grants, investment, and support for the next build stage.', s: 'Funding enquiry: FloodSense Ghana' },
  { k: 'Press', d: 'Media, interviews, and speaking requests.', s: 'Press enquiry: FloodSense Ghana' },
];
const mailto = (subject: string) => `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---
<BaseLayout
  title="Contact"
  description="Contact FloodSense Ghana for partnership, funding, and press enquiries.">

  <PageHeader
    eyebrow="Get in touch"
    title="Let's talk about reaching the communities that get missed."
    lede="Whether you're a funder, an agency, a researcher, or a journalist, we'd like to hear from you."
  />

  <!-- DIRECT ROUTES -->
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {routes.map((r) => (
          <a class="route card" href={mailto(r.s)}>
            <span class="route__k">{r.k}</span>
            <p class="route__d">{r.d}</p>
            <span class="route__cta">Email us</span>
          </a>
        ))}
      </div>

      <p class="contact__direct">
        Prefer a plain email? Write to
        <a href={`mailto:${site.email}`}>{site.email}</a> ·
        <span class="muted">{site.region}</span>
      </p>
    </div>
  </section>

  <!-- FORM -->
  <section class="section section--panel">
    <div class="container contact__grid">
      <div class="stack">
        <p class="eyebrow">Send a message</p>
        <h2>Or drop us a line here</h2>
        <p class="lede">Tell us who you are and how you'd like to work together. We read every message.</p>
        <p class="form-note">
          <strong>Note:</strong> this form activates automatically when the site
          is deployed to Netlify. On other hosts, connect a form service such as
          Formspree, or simply use the direct email above.
        </p>
      </div>

      <form
        class="contact-form card"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/thanks/"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden-field">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="org">Organisation <span class="opt">(optional)</span></label>
          <input id="org" name="organisation" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="reason">I'm reaching out about</label>
          <select id="reason" name="reason">
            <option>Partnership</option>
            <option>Funding</option>
            <option>Press</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .route { text-decoration: none; color: inherit; display: grid; gap: 0.4rem; transition: transform 0.15s ease, border-color 0.15s ease; }
  .route:hover { transform: translateY(-2px); border-color: var(--brand); }
  .route__k { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); }
  .route__d { color: var(--text-muted); font-size: 0.95rem; }
  .route__cta { color: var(--brand); font-weight: 600; font-family: var(--font-display); margin-top: 0.3rem; }

  .contact__direct { margin-top: 1.6rem; font-size: 1rem; }

  .contact__grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(1.6rem, 4vw, 3rem); align-items: start; }
  .contact__grid h2 { font-size: var(--step-3); }
  .form-note {
    font-size: 0.9rem; color: var(--ink-700);
    background: var(--status-design-bg); border: 1px solid #b9d4dc;
    border-left: 3px solid var(--status-design); border-radius: var(--radius); padding: 0.85rem 1rem;
  }

  .contact-form { display: grid; gap: 1rem; background: var(--bg-panel); }
  .field { display: grid; gap: 0.35rem; }
  .field label { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; }
  .field .opt { color: var(--text-muted); font-weight: 400; }
  .field input, .field select, .field textarea {
    font: inherit; font-size: 0.98rem; padding: 0.65rem 0.8rem;
    border: 1.5px solid var(--line-strong); border-radius: var(--radius);
    background: var(--sand-50); color: var(--text); width: 100%;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--volta-500); background: #fff;
  }
  .contact-form .btn { justify-self: start; margin-top: 0.3rem; }
  .hidden-field { display: none; }

  @media (max-width: 820px) { .contact__grid { grid-template-columns: 1fr; } }
</style>
